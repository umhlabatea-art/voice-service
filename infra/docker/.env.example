# infra/docker — monitoring stack env
# Copy to .env in Coolify (or paste each var into the resource's Environment tab).
# Never commit the filled-in .env; only this .example belongs in git.

# ── GlitchTip (error tracking) ──────────────────────────────────────────────
# Postgres password for the bundled glitchtip-db.
POSTGRES_PASSWORD=change-me-strong-random
# Django secret. Generate: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# Public URL Coolify assigns the glitchtip-web service (used in DSNs + emails).
GLITCHTIP_DOMAIN=https://errors.umhlabatea.example
# Outbound email for invites/alerts. consolemail:// logs to stdout (no email).
# SMTP example: smtp://user:pass@smtp.host:587
EMAIL_URL=consolemail://

# ── Uptime Kuma (alerting) ──────────────────────────────────────────────────
# Kuma stores config in its own volume; no build-time env required.
# These are for the post-deploy Telegram notification channel (see README).
TELEGRAM_BOT_TOKEN=reuse-existing-HITL-bot-token
TELEGRAM_CHAT_ID=reuse-existing-HITL-chat-id
