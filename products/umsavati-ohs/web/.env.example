# Umsavati OS dashboard — Supabase connection (Archon backend lpafkclumhhwsvgxrkwv)
# Copy to .env.local and fill in. NEVER commit .env files.
NEXT_PUBLIC_SUPABASE_URL=https://lpafkclumhhwsvgxrkwv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=__FILL__

# GlitchTip error tracking (Sentry-compatible). Leave blank until GlitchTip is
# deployed (infra/docker) — the SDK self-disables when the DSN is empty.
# Value = the project DSN from GlitchTip → Project → Settings.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Environment tag + trace sampling (0.0–1.0). Defaults: NODE_ENV, 0.1.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
