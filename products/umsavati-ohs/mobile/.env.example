# Umsavati OHS mobile — Supabase connection (Archon backend lpafkclumhhwsvgxrkwv)
# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* into the client bundle,
# so ONLY the publishable/anon key belongs here — never the service secret.
EXPO_PUBLIC_SUPABASE_URL=https://lpafkclumhhwsvgxrkwv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=__FILL_WITH_sb_publishable_KEY__
